{
	"schema": {
		"type": "object",
		"required": [
			"idPendenza",
			"soggettoPagatore",
			"targa",
			"data",
			"importo"
		],
		"properties": {
			"idPendenza": {
				"type": "string",
				"pattern": "[A-Za-z0-9\\-_]{1,35}"
			},
			"soggettoPagatore": {
				"type": "object",
				"required": [
					"identificativo",
					"anagrafica"
				],
				"properties": {
					"identificativo": {
						"type": "string",
						"pattern": "[A-Z]{6}\\d{2}[A-Z]\\d{2}[A-Z]\\d{3}[A-Z]"
					},
					"anagrafica": {
						"type": "string"
					}
				}
			},
			"targa": {
				"type": "string",
				"pattern": "[A-Za-z0-9]{1,35}"
			},
			"data": {
				"type": "string",
				"format": "date"
			},
			"importo": {
				"type": "number",
				"multipleOf": 0.01,
				"exclusiveMinimum": 0
			}
		}
	},
	"layout_ita": [
		{
			"key": "idPendenza",
			"title": "Numero verbale"
		},
		{
			"key": "soggettoPagatore.anagrafica",
			"title": "Anagrafica debitore",
			"placeholder": "Nome e cognome"
		},
		{
			"key": "soggettoPagatore.identificativo",
			"title": "Codice fiscale debitore"
		},
		{
			"key": "targa",
			"title": "Targa o telaio del veicolo sanzionato"
		},
		{
			"key": "data",
			"title": "Data dell'infrazione"
		},
		{
			"key": "importo",
			"title": "Importo"
		}
	]
}
